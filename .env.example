FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-me
WTF_CSRF_SECRET_KEY=replace-me-csrf
SESSION_SECRET=replace-me-session
POSTGRES_DB=minty_ref
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass
S3_BUCKET=dummy-bucket
S3_KEY=dummy-key
S3_SECRET=dummy-secret
S3_REGION=us-east-1

# --- Xero OAuth integration ---
# Get these from your Xero app at https://developer.xero.com/myapps
# Ask the team for the development app's credentials; do NOT commit real values.
#
# IMPORTANT: XERO_REDIRECT_URI must be registered *exactly* as written below in
# the Xero app's "Redirect URIs" list (scheme, host, port and path must all
# match). If only the deployed URLs are registered there, add the localhost one
# or Xero will reject the login with "unauthorized_client".
#
# Leaving these blank makes Xero login fail with:
#   Error: unauthorized_client — Unknown client or client not enabled
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5001/callback
XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0

# --- Outbound email ---
# Brevo SMTP relay. Without MAIL_SERVER the mail extension is never usable, and
# every send (OTP, invitations, billing notices) is logged and skipped rather
# than failing the operation that triggered it.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_EMAIL=noreply@example.com

# Public origin used to build links in ALL outbound email — invitation accept
# links and the billing notices both read this one. It matters most for the
# billing emails: they are sent from `flask subscriptions ...` CLI jobs, where
# there is no request to derive a host from. Unset simply drops the buttons out
# of those emails — the wording still stands on its own.
PUBLIC_URL=http://localhost:5001

# Module 2 (Billing) handover. SECRET_KEY above MUST equal the billing
# backend's SECRET_KEY so JWTs verify on both sides.
FRONTEND_APP_URL=http://localhost:3000
# Optional path overrides (defaults are sane):
# PAYMENT_REQUEST_APP_HOME_PATH=
# PAYMENT_REQUEST_SETTINGS_PATH=settings
# PAYMENT_REQUEST_PROFILE_PATH=profile

# --- Subscription passes ---
# The in-process scheduler that ends trials, raises renewal invoices, retries
# dunning and reconciles module access. Nothing else does any of those, so with
# this off a trial never ends and nobody is billed after their first period.
#
# It runs two passes. The FULL pass, once a day, does all five jobs including
# the unscoped access sweep — the one job that costs the whole customer base
# every time it runs. The LIGHT pass, every other hour, closes trials and raises
# renewals, then sweeps only the payers it touched. So a trial ends within an
# hour of its term, while the expensive sweep still runs once a day.
#
# UNSET BY DEFAULT, and that is deliberate: set it ONLY in the deployed web
# service. A developer running the app against a database with real payers in it
# would otherwise start charging them within the hour.
#
# There is no separate switch for billing. Turning this off is the kill switch,
# and it is the honest one: a flag that stopped renewals would still leave
# close-trials charging converting trials and dunning retrying invoices already
# owed. For a preview that moves no money, run `flask subscriptions run-renewals`
# by hand — it is dry unless given --issue.
SUBSCRIPTION_SCHEDULER_ENABLED=0
# Which hour carries the full pass. Default 5, i.e. 05:00 Asia/Hong_Kong: the
# expensive sweep runs while the system is quiet and the summary is waiting to be
# read by the time anyone starts work.
# SUBSCRIPTION_SCHEDULER_FULL_HOUR=5
# SUBSCRIPTION_SCHEDULER_TZ=Asia/Hong_Kong
# Set to 0 to drop back to ONE full pass a day with no hourly light passes.
# SUBSCRIPTION_SCHEDULER_LIGHT=1

