FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-me
WTF_CSRF_SECRET_KEY=replace-me-csrf
SESSION_SECRET=replace-me-session
POSTGRES_DB=minty_ref
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass
S3_BUCKET=dummy-bucket
S3_KEY=dummy-key
S3_SECRET=dummy-secret
S3_REGION=us-east-1

# Module 2 (Billing) handover. SECRET_KEY above MUST equal the billing
# backend's SECRET_KEY so JWTs verify on both sides.
FRONTEND_APP_URL=http://localhost:3000
# Optional path overrides (defaults are sane):
# PAYMENT_REQUEST_APP_HOME_PATH=
# PAYMENT_REQUEST_SETTINGS_PATH=settings
# PAYMENT_REQUEST_PROFILE_PATH=profile
