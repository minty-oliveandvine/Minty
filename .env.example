# Petty Cash (Minty, Flask) — environment. Copy to `.env` and fill in.
# Placeholders only: never commit real values. The cross-repo reference (every
# service, port, URL and the old -> new rename table) is docs/ENVIRONMENT.md.

# --- Runtime ---
# development | production (default production; anything else counts as production).
# development turns on Flask debug and allows Xero's OAuth callback over plain http.
APP_ENV=development

# Shared HS256 key: Flask mints the module JWTs and the Django APIs verify them, so it
# MUST be identical across Petty Cash, payment-request-api, subscription-api and
# onboarding-api. Also signs sessions and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# --- Database ---
# One URL; the schema rides in ?schema= (default pettycashv3) and is never passed to the
# driver. Other query params (e.g. &sslmode=require) are kept. User and password must be
# URL-encoded (e.g. @ -> %40).
# The schema, kept as its own line and filled into the URL below (pettycashv3 - the
# permanent name). Hosting dashboards don't expand ${...}: there, write the name into the URL.
DB_SCHEMA=pettycashv3
DATABASE_URL=postgresql://minty_ref_user:minty_ref_pass@localhost:5432/minty_ref?schema=${DB_SCHEMA}

# --- Attachment storage (Backblaze B2, S3 API) ---
# https://KEY:SECRET@s3.<region>.backblazeb2.com/<bucket> — KEY and SECRET URL-encoded.
# The region is read from the host (or ?region=).
S3_URL=https://dummy-key:dummy-secret@s3.us-west-004.backblazeb2.com/dummy-bucket

# --- Outbound email ---
# smtp://USER:PASSWORD@HOST:587 (STARTTLS) or smtps://USER:PASSWORD@HOST:465 (implicit
# SSL); USER and PASSWORD URL-encoded. Optional ?timeout=10 (seconds); ?tls=0 turns off
# STARTTLS for a local mail catcher. Unset, every send (OTP, invitations, billing
# notices) is logged and skipped rather than failing the operation that triggered it.
SMTP_URL=
# Default From address for all mail.
MAIL_FROM=noreply@example.com

# --- Service URLs (browser-facing; trailing slashes are stripped) ---
# This app's own public origin: links in ALL outbound email (including any sent outside a
# request, where there is no host to derive) and the Xero redirect URI, PETTY_CASH_URL/callback.
PETTY_CASH_URL=http://localhost:8010
# minty-web, the hub: a company's Module page, My Profile and the payer portal live
# there; /handoff/minty-web is the way back in when its token lapses.
MINTY_WEB_URL=http://localhost:3000
# minty-subscription-api, which the sidebar's Subscriptions Overview reads from the
# browser (docs/features/sidebar.md) and the dashboard's subscription notice reads
# server-side (services/subscription_api.py). Its CORS must allow this app's public origin.
SUBSCRIPTION_API_URL=http://localhost:8000
# minty-payment-request-web, the Payment Request module (handover target).
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
# minty-onboarding-web, the sign-up wizard.
ONBOARDING_WEB_URL=http://localhost:3030

# --- Xero OAuth ---
# Get these from your Xero app at https://developer.xero.com/myapps
# Ask the team for the development app's credentials; do NOT commit real values.
#
# The redirect URI is PETTY_CASH_URL + /callback (http://localhost:8010/callback
# locally) and must be registered *exactly* in the Xero app's "Redirect URIs" list, or
# Xero rejects the login with "unauthorized_client".
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- Spire.Doc licence (DOCX export) ---
SPIRE_KEY=

# --- Feature flags ---
# None for the hub: since phase 2 (2026-10-05) the entity list, My Profile and sign-in are
# always minty-web's (MINTY_WEB_URL), so it must be deployed wherever this app is.

# Subscriptions are minty-subscription-api's (since 2026-10-06 this app holds no Stripe
# keys and runs no subscription pass); its own .env carries STRIPE_* and
# SUBSCRIPTION_SCHEDULER_*. Migration m1a01 is a no-op.

# --- AI-assisted expense capture (docs/expense_ai/Stage 1 Expense Implementation.md) ---
# Reads an attached receipt on /report/expense and prefills four fields as
# SUGGESTIONS. Nothing posts automatically, and with the switch off the Add
# New Expense card behaves exactly as it does today.
#
# THE KILL SWITCH. Default off — the feature ships dark (plan §11.1). Turning
# it off is rollback level 1: immediate, no deployment, no data impact.
EXPENSE_AI_ENABLED=false

# --- Route to the model: Vertex AI (production) ---
# Set GOOGLE_CLOUD_PROJECT and the Vertex route is used automatically: IAM
# instead of a long-lived key, and an in-region endpoint whose ML-processing
# residency commitment keeps inference where the receipts already sit.
#
# EXPENSE_AI_LOCATION IS A COMPLIANCE SETTING, NOT A PERFORMANCE KNOB (§8.5).
# Changing it changes which country processes customer financial documents.
# Never set it to `global`: the global endpoint gives up both the residency
# commitment and context caching.
# GOOGLE_CLOUD_PROJECT=
# EXPENSE_AI_LOCATION=asia-southeast1

# --- Route to the model: direct Gemini API (SPIKE ONLY) ---
# An explicit opt-in, never a fallback, because the two routes are identical
# at the call site and completely different in their terms:
#
#   free tier  Google may use submitted content to "provide, improve, and
#              develop Google products", and HUMAN REVIEWERS may read,
#              annotate and process API input and output.
#              NEVER a customer receipt. Not once, not for a quick test.
#   paid tier  not used for product improvement, but data may be stored or
#              cached "in any country in which Google maintains facilities".
#              Spike only, on our own or synthetic receipts.
#
# Use this to run the §15 Stage 1 spike before the Google Cloud project
# exists. Delete the key when the spike ends.
# EXPENSE_AI_ALLOW_DIRECT_API=false
# Which Gemini API terms we operate under: paid | free. Defaults to free,
# because nothing at the call site can tell the tiers apart and the safe
# assumption about an unconfirmed key is the restrictive one. On paid,
# content is not used to improve Google products and no human reads it —
# but there is still NO residency control on this route.
# EXPENSE_AI_DIRECT_TIER=free
# GEMINI_API_KEY=

# --- Model and request shape ---
# Spike on the strongest candidate so the accuracy figure is a ceiling; step
# down to Flash on evidence. gemini-3.1-pro-preview is a PREVIEW model — fine
# for a throwaway spike, never the production pin (§5.3).
# MUST be a Gemini 3.x id. The interactions API this feature calls serves
# 3.x only — gemini-2.5-flash is still listed by models.list() and still
# works through the legacy generateContent, so it looks available, but it
# returns 404 here. Do not switch to 2.5 to dodge a free-tier quota.
EXPENSE_AI_MODEL=gemini-3.5-flash
# low / medium / high. Receipt extraction is a bounded perception-and-lookup
# task, not a reasoning problem. Measure before defaulting higher.
EXPENSE_AI_THINKING_LEVEL=low
# NOT just the reply: on Gemini 3.x THINKING TOKENS COME OUT OF THIS SAME
# ALLOWANCE. The JSON is ~200 tokens, but a measured call spent 322 more on
# thinking, and a longer think truncates the reply mid-object. The plan's
# "~1,024 is ample" sized the reply, not the budget.
EXPENSE_AI_MAX_OUTPUT_TOKENS=4096
EXPENSE_AI_TIMEOUT_S=25
EXPENSE_AI_MAX_FILE_MB=10

# --- Confidence bands (§6.2) ---
# Below the medium cut-off NOTHING is prefilled: a wrong suggestion costs the
# user more than no suggestion. These are placeholders. Confidence is
# self-reported by the model, not a measured probability — set both from the
# spike's accuracy-per-band table before pilot.
EXPENSE_AI_CONF_HIGH=0.85
EXPENSE_AI_CONF_MEDIUM=0.60

# --- Abuse and cost protection (§8.6) ---
EXPENSE_AI_RATE_USER_PER_MIN=10
EXPENSE_AI_RATE_ENTITY_PER_HOUR=200

# Audit-table retention in days (§8.5). The purge job reads this.
EXPENSE_AI_RETENTION_DAYS=90
