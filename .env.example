FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-me
WTF_CSRF_SECRET_KEY=replace-me-csrf
SESSION_SECRET=replace-me-session
POSTGRES_DB=minty_ref
# The schema every model lives in (blueprints/shared/schema.py). pettycashv3 is the permanent
# production name; the variable exists so the name is a setting, not a literal - the test
# harness builds the schema under whatever this says. Same variable in both Django services.
MINTY_DB_SCHEMA=pettycashv3
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass
S3_BUCKET=dummy-bucket
S3_KEY=dummy-key
S3_SECRET=dummy-secret
S3_REGION=us-east-1

# --- Xero OAuth integration ---
# Get these from your Xero app at https://developer.xero.com/myapps
# Ask the team for the development app's credentials; do NOT commit real values.
#
# IMPORTANT: XERO_REDIRECT_URI must be registered *exactly* as written below in
# the Xero app's "Redirect URIs" list (scheme, host, port and path must all
# match). If only the deployed URLs are registered there, add the localhost one
# or Xero will reject the login with "unauthorized_client".
#
# Leaving these blank makes Xero login fail with:
#   Error: unauthorized_client — Unknown client or client not enabled
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5001/callback
XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0

# --- Outbound email ---
# Brevo SMTP relay. Without MAIL_SERVER the mail extension is never usable, and
# every send (OTP, invitations, billing notices) is logged and skipped rather
# than failing the operation that triggered it.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_EMAIL=noreply@example.com

# From address for BILLING email only (trial warnings, receipts, dunning, handovers).
# Everything else keeps BREVO_EMAIL. MUST be a verified sender in Brevo — an unverified
# From is rejected or spam-filed, and the send is swallowed silently. Unset falls back
# to BREVO_EMAIL.
SUBSCRIPTION_EMAIL=

# Public origin used to build links in ALL outbound email — invitation accept
# links and the billing notices both read this one. It matters most for the
# billing emails: they are sent from `flask subscriptions ...` CLI jobs, where
# there is no request to derive a host from. Unset simply drops the buttons out
# of those emails — the wording still stands on its own.
PUBLIC_URL=http://localhost:5001

# Module 2 (Billing) handover. SECRET_KEY above MUST equal the billing
# backend's SECRET_KEY so JWTs verify on both sides.
FRONTEND_APP_URL=http://localhost:3000
# minty-web (the hub, Part 2): a company's module settings page lives there. Live, Flask's
# /entity/settings/module/<id> sends the browser to it with a token; /handoff/minty-web is
# the way back in when that token lapses. MINTY_WEB_MODULE_PAGE=0 keeps the old Jinja page
# (for running Flask alone); it goes at step 5 with that page.
MINTY_WEB_URL=http://localhost:3002
# MINTY_WEB_MODULE_PAGE=1
# The entity list and My Profile live in minty-web too (its /entities and /profile). ON,
# /entity and every "open my profile" link go there; OFF (the default), the Jinja list and
# the payments app's profile, as before. Off unless set on purpose: /entity is the first page
# after every login - switch it on only where minty-web is deployed.
# MINTY_WEB_HUB=1
# Optional path overrides (defaults are sane):
# PAYMENT_REQUEST_APP_HOME_PATH=
# PAYMENT_REQUEST_SETTINGS_PATH=settings
# PAYMENT_REQUEST_PROFILE_PATH=profile

# The subscription feature as a whole - plans, trials, checkout, the payer portal, the
# notices, the daily pass. OFF unless set: production cut over to the redesigned schema
# with subscriptions dark (docs/modernisation/modernisation_plan.md, Phase E). Off, module
# access is entity_function_map.is_enabled as it was before the engine, the module page
# is a plain on/off list, and every quote/charge/portal route answers 404. Switching it
# on grants nothing and starts no trial; `flask subscriptions revoke-ungranted` is the
# separate launch-day step. Read by migration m1a01 too (skipped while off).
SUBSCRIPTION_ENABLED=0

# --- Subscription passes ---
# The in-process scheduler that ends trials, raises renewal invoices, retries
# dunning and reconciles module access. Nothing else does any of those, so with
# this off a trial never ends and nobody is billed after their first period.
#
# It runs two passes. The FULL pass, once a day, does all five jobs including
# the unscoped access sweep — the one job that costs the whole customer base
# every time it runs. The LIGHT pass, every other hour, closes trials and raises
# renewals, then sweeps only the payers it touched. So a trial ends within an
# hour of its term, while the expensive sweep still runs once a day.
#
# UNSET BY DEFAULT, and that is deliberate: set it ONLY in the deployed web
# service. A developer running the app against a database with real payers in it
# would otherwise start charging them within the hour.
#
# There is no separate switch for billing. Turning this off is the kill switch,
# and it is the honest one: a flag that stopped renewals would still leave
# close-trials charging converting trials and dunning retrying invoices already
# owed. For a preview that moves no money, run `flask subscriptions run-renewals`
# by hand — it is dry unless given --issue.
SUBSCRIPTION_SCHEDULER_ENABLED=0
# Which hour carries the full pass. Default 5, i.e. 05:00 Asia/Hong_Kong: the
# expensive sweep runs while the system is quiet and the summary is waiting to be
# read by the time anyone starts work.
# SUBSCRIPTION_SCHEDULER_FULL_HOUR=5
# SUBSCRIPTION_SCHEDULER_TZ=Asia/Hong_Kong
# Set to 0 to drop back to ONE full pass a day with no hourly light passes.
# SUBSCRIPTION_SCHEDULER_LIGHT=1


# --- AI-assisted expense capture (docs/expense_ai/Stage 1 Expense Implementation.md) ---
# Reads an attached receipt on /report/expense and prefills four fields as
# SUGGESTIONS. Nothing posts automatically, and with the switch off the Add
# New Expense card behaves exactly as it does today.
#
# THE KILL SWITCH. Default off — the feature ships dark (plan §11.1). Turning
# it off is rollback level 1: immediate, no deployment, no data impact.
EXPENSE_AI_ENABLED=false

# --- Route to the model: Vertex AI (production) ---
# Set GOOGLE_CLOUD_PROJECT and the Vertex route is used automatically: IAM
# instead of a long-lived key, and an in-region endpoint whose ML-processing
# residency commitment keeps inference where the receipts already sit.
#
# EXPENSE_AI_LOCATION IS A COMPLIANCE SETTING, NOT A PERFORMANCE KNOB (§8.5).
# Changing it changes which country processes customer financial documents.
# Never set it to `global`: the global endpoint gives up both the residency
# commitment and context caching.
# GOOGLE_CLOUD_PROJECT=
# EXPENSE_AI_LOCATION=asia-southeast1

# --- Route to the model: direct Gemini API (SPIKE ONLY) ---
# An explicit opt-in, never a fallback, because the two routes are identical
# at the call site and completely different in their terms:
#
#   free tier  Google may use submitted content to "provide, improve, and
#              develop Google products", and HUMAN REVIEWERS may read,
#              annotate and process API input and output.
#              NEVER a customer receipt. Not once, not for a quick test.
#   paid tier  not used for product improvement, but data may be stored or
#              cached "in any country in which Google maintains facilities".
#              Spike only, on our own or synthetic receipts.
#
# Use this to run the §15 Stage 1 spike before the Google Cloud project
# exists. Delete the key when the spike ends.
# EXPENSE_AI_ALLOW_DIRECT_API=false
# Which Gemini API terms we operate under: paid | free. Defaults to free,
# because nothing at the call site can tell the tiers apart and the safe
# assumption about an unconfirmed key is the restrictive one. On paid,
# content is not used to improve Google products and no human reads it —
# but there is still NO residency control on this route.
# EXPENSE_AI_DIRECT_TIER=free
# GEMINI_API_KEY=

# --- Model and request shape ---
# Spike on the strongest candidate so the accuracy figure is a ceiling; step
# down to Flash on evidence. gemini-3.1-pro-preview is a PREVIEW model — fine
# for a throwaway spike, never the production pin (§5.3).
# MUST be a Gemini 3.x id. The interactions API this feature calls serves
# 3.x only — gemini-2.5-flash is still listed by models.list() and still
# works through the legacy generateContent, so it looks available, but it
# returns 404 here. Do not switch to 2.5 to dodge a free-tier quota.
EXPENSE_AI_MODEL=gemini-3.5-flash
# low / medium / high. Receipt extraction is a bounded perception-and-lookup
# task, not a reasoning problem. Measure before defaulting higher.
EXPENSE_AI_THINKING_LEVEL=low
# NOT just the reply: on Gemini 3.x THINKING TOKENS COME OUT OF THIS SAME
# ALLOWANCE. The JSON is ~200 tokens, but a measured call spent 322 more on
# thinking, and a longer think truncates the reply mid-object. The plan's
# "~1,024 is ample" sized the reply, not the budget.
EXPENSE_AI_MAX_OUTPUT_TOKENS=4096
EXPENSE_AI_TIMEOUT_S=25
EXPENSE_AI_MAX_FILE_MB=10

# --- Confidence bands (§6.2) ---
# Below the medium cut-off NOTHING is prefilled: a wrong suggestion costs the
# user more than no suggestion. These are placeholders. Confidence is
# self-reported by the model, not a measured probability — set both from the
# spike's accuracy-per-band table before pilot.
EXPENSE_AI_CONF_HIGH=0.85
EXPENSE_AI_CONF_MEDIUM=0.60

# --- Abuse and cost protection (§8.6) ---
EXPENSE_AI_RATE_USER_PER_MIN=10
EXPENSE_AI_RATE_ENTITY_PER_HOUR=200

# Audit-table retention in days (§8.5). The purge job reads this.
EXPENSE_AI_RETENTION_DAYS=90
