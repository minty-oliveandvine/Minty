# Minty full-stack local environment.
#
# Copy to `.env` in this folder before starting the stack:
#   cp .env.example .env
#
# Two jobs at once:
#   1. Compose reads this file for ${VAR} substitution inside the compose files.
#   2. It is passed into the Python containers as env_file, layered ON TOP of
#      each repo's own .env — so secrets you already have in ../../.env (Minty)
#      and the sibling repos' .env files keep working and you only need to fill
#      in here what you want to change. A line set here, even to an empty value,
#      hides the repo's value — so leave secrets commented out unless you mean it.
#
# The compose file sets DATABASE_URL, SECRET_KEY, APP_ENV and every service URL
# itself (internal hostnames for server-to-server calls, localhost for the
# browser), so those never need to go in a repo .env for the stack.
# Full variable reference: docs/ENVIRONMENT.md.
#
# IMPORTANT: no inline comments after a value. `FOO=bar # note` sets FOO to
# "bar # note" when the file is used as an env_file. Put comments on their own
# line, as below.


# ---------------------------------------------------------------------------
# Shared database
#
# Every service shares ONE database and the pettycashv3 schema inside it. These
# POSTGRES_* configure the db container; compose builds each service's
#   DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DB?schema=${DB_SCHEMA}
# from them.
# ---------------------------------------------------------------------------
POSTGRES_DB=minty_ref
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass
# The schema inside it, for every service (pettycashv3 - the permanent name).
DB_SCHEMA=pettycashv3

# Host port for the database (5433 so a local Postgres on 5432 doesn't clash).
# Containers always talk to it on db:5432 internally.
DB_HOST_PORT=5433


# ---------------------------------------------------------------------------
# Shared secret — the one value that MUST be identical across services.
#
# Flask mints the JWTs that hand a signed-in user over to the other modules;
# the Django APIs verify them with this same key. A mismatch turns every module
# handoff into a 401. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=replace-me-shared-across-flask-and-django


# ---------------------------------------------------------------------------
# Host ports (slot N: web 30N0, api 80N0).
#
# The browser-facing URLs handed to each service (redirects, email links, CORS
# origins, Next.js fetches) are built from these as http://localhost:<port>, so
# changing a port here is all it takes.
# ---------------------------------------------------------------------------
MINTY_WEB_HOST_PORT=3000
SUBSCRIPTION_API_HOST_PORT=8000
MINTY_HOST_PORT=8010
PAYMENT_REQUEST_WEB_HOST_PORT=3020
PAYMENT_REQUEST_API_HOST_PORT=8020
ONBOARDING_WEB_HOST_PORT=3030
ONBOARDING_API_HOST_PORT=8030


# ---------------------------------------------------------------------------
# Where the sibling repos live, relative to this folder (docker/stack).
#
# Defaults assume all seven are checked out next to each other under their
# current names:
#   C:\Github\{Minty,minty-web,minty-subscription-api,minty-payment-request-api,
#              minty-payment-request-web,minty-onboarding-api,minty-onboarding-web}
# Uncomment and set paths only if your layout differs (e.g. a checkout still in a
# folder named after the old repo name).
# ---------------------------------------------------------------------------
# MINTY_PATH=../..
# MINTY_WEB_PATH=../../../minty-web
# SUBSCRIPTION_API_PATH=../../../minty-subscription-api
# PAYMENT_REQUEST_API_PATH=../../../minty-payment-request-api
# PAYMENT_REQUEST_WEB_PATH=../../../minty-payment-request-web
# ONBOARDING_API_PATH=../../../minty-onboarding-api
# ONBOARDING_WEB_PATH=../../../minty-onboarding-web


# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# development | production. development = Flask/Django debug on, and Xero's OAuth
# callback allowed over plain http://localhost.
APP_ENV=development
ALLOWED_HOSTS=*

# Whether to run migrations on start (both Flask and Django).
#
# OFF by default, and not an arbitrary choice: the Alembic chain cannot build a
# database from empty today — 0001_full_schema was consolidated from the current
# models, but the revisions after it still assume the pre-consolidation state
# and collide with it. So the stack starts with an empty database and you load a
# schema into it yourself. See "Getting a schema" in README.md.
#
# Turn this on once the chain is repaired, or when running against a database
# that is already past the broken revisions.
RUN_MIGRATIONS=false

# Only used when running without the dev override (gunicorn instead of the
# auto-reloading dev servers).
GUNICORN_WORKERS=4

# Subscriptions are always on (the dark switch was removed on 2026-10-01). The one switch
# left is the daily pass, in Minty AND subscription-api: leave BOTH off locally - the two
# engines share the database, and either one pointed at real payers starts charging them.
SUBSCRIPTION_SCHEDULER_ENABLED=0


# ---------------------------------------------------------------------------
# S3 / Backblaze — attachment uploads (minty and payment-request-api).
#   S3_URL=https://KEY:SECRET@s3.<region>.backblazeb2.com/<bucket>
# KEY and SECRET must be URL-encoded. Left unset, compose passes a dummy URL that
# lets the stack boot; uploads fail until it is real.
# ---------------------------------------------------------------------------
# S3_URL=


# ---------------------------------------------------------------------------
# Secrets normally supplied by each repo's own .env. Uncomment only to override
# them for the stack — remember an uncommented empty line hides the repo value.
# ---------------------------------------------------------------------------
# Xero OAuth — minty only. Flask is the SOLE refresher of Xero tokens; the Django
# APIs ask it for one at PETTY_CASH_URL/api/internal/xero/token. The redirect URI
# is PETTY_CASH_URL/callback = http://localhost:8010/callback here, and it must be
# registered verbatim in the Xero app or login fails with "unauthorized_client".
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# Outbound email — minty and subscription-api. Unset, Flask logs and skips every
# send and Django prints mail to the console.
#   SMTP_URL=smtp://USER:PASSWORD@smtp-relay.brevo.com:587
# MAIL_FROM=noreply@example.com

# Stripe test-mode keys — subscription-api (and minty).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
