# Minty full-stack local environment.
#
# Copy to `.env` in this folder before starting the stack:
#   cp .env.example .env
#
# Two jobs at once:
#   1. Compose reads this file for ${VAR} substitution inside the compose files.
#   2. It is passed into the Flask and Django containers as env_file, layered
#      ON TOP of each repo's own .env — so secrets you already have in
#      ../../.env (Minty) and ../../../billing-backend/.env keep working and you
#      only need to fill in here what you want to change.
#
# IMPORTANT: no inline comments after a value. `FOO=bar # note` sets FOO to
# "bar # note" when the file is used as an env_file. Put comments on their own
# line, as below.


# ---------------------------------------------------------------------------
# Shared database
#
# Module 1 (Flask) and Module 2 (Django) share ONE database and the pettycashv3
# schema inside it. Never point them at different databases.
# ---------------------------------------------------------------------------
POSTGRES_DB=minty_ref
# The schema inside it, for all three services (default pettycashv3 - the permanent name).
MINTY_DB_SCHEMA=pettycashv3
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass

# Host port for the database. Change this (e.g. 5433) if you already run
# Postgres locally on 5432. Containers always talk to it on 5432 internally.
DB_HOST_PORT=5432


# ---------------------------------------------------------------------------
# Shared secret — the one value that MUST be identical across services.
#
# Flask mints the JWTs that hand a signed-in user over to the billing module;
# Django verifies them with this same key. A mismatch turns every module handoff
# into a 401. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=replace-me-shared-across-flask-and-django
SESSION_SECRET=replace-me-session
WTF_CSRF_SECRET_KEY=replace-me-csrf


# ---------------------------------------------------------------------------
# Host ports and the public URLs that match them.
#
# The *_PUBLIC_URL values are handed to the browser (redirects, email links,
# NEXT_PUBLIC_* fetches), so they must be reachable from your machine — never
# container names. If you change a *_HOST_PORT, change the matching URL too.
# ---------------------------------------------------------------------------
MINTY_HOST_PORT=5001
MINTY_PUBLIC_URL=http://localhost:5001

BILLING_BACKEND_HOST_PORT=8000
BILLING_BACKEND_PUBLIC_URL=http://localhost:8000

BILLING_FRONTEND_HOST_PORT=3000
BILLING_FRONTEND_PUBLIC_URL=http://localhost:3000

ONBOARDING_HOST_PORT=3001
ONBOARDING_PUBLIC_URL=http://localhost:3001

ONBOARDING_BACKEND_HOST_PORT=8001
ONBOARDING_BACKEND_PUBLIC_URL=http://localhost:8001

# Part 2: the subscription API and the hub (rule 6 - one digit per domain, 800d / 300d).
BILLING_API_HOST_PORT=8004
BILLING_API_PUBLIC_URL=http://localhost:8004

MINTY_WEB_HOST_PORT=3002
MINTY_WEB_PUBLIC_URL=http://localhost:3002


# ---------------------------------------------------------------------------
# Where the sibling repos live, relative to this folder (docker/stack).
#
# Defaults assume all seven are checked out next to each other:
#   C:\Github\{Minty,billing-backend,billing-frontend,onboarding,onboarding-backend,
#              minty-billing-api,minty-web}
# Uncomment and set absolute paths only if your layout differs.
# ---------------------------------------------------------------------------
# MINTY_PATH=../..
# BILLING_BACKEND_PATH=../../../billing-backend
# BILLING_FRONTEND_PATH=../../../billing-frontend
# ONBOARDING_PATH=../../../onboarding
# ONBOARDING_BACKEND_PATH=../../../onboarding-backend
# BILLING_API_PATH=../../../minty-billing-api
# MINTY_WEB_PATH=../../../minty-web


# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
NEXT_PUBLIC_APP_ENV=development

# Whether to run migrations on start (both Flask and Django).
#
# OFF by default, and not an arbitrary choice: the Alembic chain cannot build a
# database from empty today — 0001_full_schema was consolidated from the current
# models, but the revisions after it still assume the pre-consolidation state
# and collide with it. So the stack starts with an empty database and you load a
# schema into it yourself. See "Getting a schema" in README.md.
#
# Turn this on once the chain is repaired, or when running against a database
# that is already past the broken revisions.
RUN_MIGRATIONS=false

# Only used when running without the dev override (gunicorn instead of the
# auto-reloading dev servers).
GUNICORN_WORKERS=4

# The in-process scheduler that ends trials and raises renewal invoices. Leave
# it off locally: pointed at a database with real payers it starts charging them
# within the hour. (In Minty today; in billing-api from Part 2 step 2.)
# Subscriptions are always on (the dark switch was removed on 2026-10-01). The one switch
# left is the daily pass, in Minty AND billing-api: leave BOTH off locally - the two engines
# share the database, and either one pointed at real payers starts charging them.
SUBSCRIPTION_SCHEDULER_ENABLED=0


# ---------------------------------------------------------------------------
# S3 / Backblaze — attachment uploads. Both Flask and Django use these.
# The dummy values let the stack boot; uploads will fail until they are real.
# ---------------------------------------------------------------------------
S3_BUCKET=dummy-bucket
S3_KEY=dummy-key
S3_SECRET=dummy-secret
S3_REGION=us-east-1
S3_ENDPOINT_URL=


# ---------------------------------------------------------------------------
# Xero OAuth — Module 1 only.
#
# The Flask app is the SOLE refresher of Xero tokens; billing asks it for one
# over XERO_TOKEN_SERVICE_URL (wired to the internal container URL in the
# compose file). Do not give billing its own Xero credentials — Xero invalidates
# a refresh token on use, so a second refresher bricks the connection.
#
# XERO_REDIRECT_URI must be registered verbatim in the Xero app's redirect URI
# list, or login fails with "unauthorized_client".
# ---------------------------------------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5001/callback
XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0


# ---------------------------------------------------------------------------
# Outbound email (Brevo SMTP) — Module 1 only.
# Without MAIL_SERVER every send (OTP, invitations, billing notices) is logged
# and skipped rather than failing the operation that triggered it.
# ---------------------------------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Seconds each SMTP step may take before the send fails (default 10).
MAIL_TIMEOUT=10
BREVO_EMAIL=noreply@example.com


# ---------------------------------------------------------------------------
# Stripe — subscriptions. Use test-mode keys locally. Read by minty today and by
# billing-api; from Part 2 step 5 billing-api is the ONLY holder (rule 9) and
# minty stops reading them.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
