# --- Environments and tooling caches ---------------------------------------
.venv/
venv/
node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.next/
.vscode/
.idea/
.DS_Store
Thumbs.db
.coverage
htmlcov/
# Claude Code's per-checkout scratch (settings.local.json holds one machine's permission
# rules); CLAUDE.md at the root is the shared instruction file and IS tracked.
.claude/

# --- Secrets ---------------------------------------------------------------
# .env.example is the documented template and stays tracked; every other variant
# (.env.bak*, .env.local, .env.production...) is a machine's own.
.env
.env.*
!.env.example

# --- Runtime + test artifacts ----------------------------------------------
# None of these are source, and two of them once leaked production data into
# the repo: a full pettycashv2 dump and the billing service logs.
*.log
*.log.zip
*.sqlite

# Flask instance folder: generated PDFs/DOCX of real reports, temp files.
# Never commit: these contain customer financial data.
instance/

# Flask-Session FileSystemCache scratch dir (created when migrations run with
# a non-database session backend; see docker/docker-entrypoint.sh).
flask_session/

# Playwright
test-results/
playwright-report/

# Word/Excel lock files (created while a doc is open)
~$*

# --- Database dumps: these contain real customer data. Never commit them. --
# Once committed a dump stays in history whether or not the file is later
# deleted. *.sql is ignored by default for the same reason; the two exceptions
# are DDL and loaders (no row data): alembic renders and the schema docs.
backups/
*.dump
*.sql.gz
*.sql
!migrations/**/*.sql
!docs/**/*.sql

# --- Retired -----------------------------------------------------------------
# Untracked 2026-09-17: the March-2026 reorg leftovers (sqlite DBs, .exe files,
# logs, session files) and the planning docs that went with them.
.archived/
