.venv
node_modules
__pycache__/*
__pycache__/logging_settings.cpython-311.pyc
__pycache__/utils.cpython-311.pyc
migrations/__pycache__/*    
migrations/versions/__pycache__/*
__pycache__/
.vscode/
.vscode/launch.json
app.log
.env
.DS_Store
venv
CLAUDE.md

# Runtime + test artifacts. None of these are source, and two of them were leaking
# production data into the repo: a full pettycashv2 dump and the billing service logs.
*.log
*.log.zip
*.sqlite

# Database dumps — these contain real customer data. Never commit them. Once
# committed a dump stays in history whether or not the file is later deleted.
backups/
*.dump
*.sql.gz
prod_*.dump
local_before_restore_*.dump
*.sql
!scripts/*.sql
!migrations/**/*.sql

# Flask instance folder — generated PDFs/DOCX of real reports, temp files.
# Never commit: these contain customer financial data.
instance/

# Flask-Session FileSystemCache scratch dir (created when migrations run with
# a non-database session backend; see docker/docker-entrypoint.sh).
flask_session/
